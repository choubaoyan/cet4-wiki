<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>CET-4 词林 · 四级词汇百科</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%238b5a2b'/%3E%3Ctext x='16' y='22' font-size='16' font-family='Georgia' fill='%23fbf9f5' text-anchor='middle'%3EC%3C/text%3E%3C/svg%3E" />
<style>
  /* ---- 设计令牌：间距 / 圆角 / 颜色 ---- */
  :root {
    --s1: 4px;  --s2: 8px;  --s3: 12px; --s4: 16px;
    --s5: 24px; --s6: 32px; --s7: 48px;

    --r1: 4px; --r2: 6px; --r3: 8px;

    --bg: #ffffff;
    --bg-sub: #f6f6f6;
    --bg-strong: #111111;
    --ink: #111111;
    --ink-2: #444444;
    --muted: #767676;
    --line: #e6e6e6;
    --line-2: #d0d0d0;

    --font-ui: "Inter", "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
    --font-mono: ui-monospace, "SF Mono", "Cascadia Mono", Consolas, monospace;
  }
  [data-theme="dark"] {
    --bg: #101010;
    --bg-sub: #191919;
    --bg-strong: #ededed;
    --ink: #ededed;
    --ink-2: #b8b8b8;
    --muted: #8f8f8f;
    --line: #262626;
    --line-2: #383838;
  }
  [data-theme="dark"] .hit { background: #2c2c2c; }
  [data-theme="dark"] .quiz-option.right { background: #1d1d1d; }
  [data-theme="dark"] .quiz-option.wrong { background: #161616; }
  [data-theme="dark"] .letters a.dim { color: #3a3a3a; }

  * { box-sizing: border-box; }
  html { background: var(--bg); }
  html, body { height: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.7 var(--font-ui);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; cursor: pointer; background: none; border: 0; }
  input { font: inherit; }
  code { font-family: var(--font-mono); font-size: .92em; background: var(--bg-sub); padding: 1px 5px; border-radius: var(--r1); }
  h1, h2, h3 { margin: 0; font-weight: 600; letter-spacing: -0.01em; }

  /* 线性图标统一规格 */
  .ico { width: 18px; height: 18px; flex: 0 0 auto; stroke: currentColor; fill: none;
         stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .ico-sm { width: 14px; height: 14px; }

  /* ---- 布局 ---- */
  .shell { display: grid; grid-template-columns: 232px minmax(0, 1fr); min-height: 100vh; }

  .sidebar {
    border-right: 1px solid var(--line);
    background: var(--bg);
    padding: var(--s5) var(--s4) var(--s5);
    position: sticky; top: 0; height: 100vh;
    display: flex; flex-direction: column; gap: var(--s5);
    overflow-y: auto;
  }
  .brand { display: flex; align-items: baseline; gap: var(--s2); padding: 0 var(--s2); }
  .brand b { font-size: 15px; font-weight: 600; letter-spacing: .01em; }
  .brand span { font-size: 12px; color: var(--muted); font-family: var(--font-mono); }

  .nav { display: grid; gap: 2px; }
  .nav a {
    display: flex; align-items: center; gap: var(--s3);
    padding: var(--s2) var(--s3); border-radius: var(--r2);
    color: var(--ink-2); font-size: 14px;
  }
  .nav a:hover { background: var(--bg-sub); color: var(--ink); }
  .nav a.on { background: var(--bg-sub); color: var(--ink); font-weight: 600; }
  .nav a em { margin-left: auto; font-style: normal; font-size: 12px; color: var(--muted); font-family: var(--font-mono); }

  .side-title {
    font-size: 11px; letter-spacing: .08em; color: var(--muted);
    padding: 0 var(--s2); margin-bottom: calc(var(--s2) * -1 + 4px);
  }
  .letters { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s1); }
  .letters a {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: 5px var(--s2); font-size: 13px; color: var(--ink-2);
    border-radius: var(--r1); font-family: var(--font-mono);
  }
  .letters a:hover { background: var(--bg-sub); color: var(--ink); }
  .letters a em { font-style: normal; font-size: 11px; color: var(--muted); }
  .letters a.dim { color: #c9c9c9; pointer-events: none; }

  .progress { margin-top: auto; border-top: 1px solid var(--line); padding-top: var(--s3); }
  .progress .row { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); padding: 0 var(--s2); }
  .bar { height: 2px; background: var(--line); margin: var(--s2) var(--s2) 0; }
  .bar i { display: block; height: 100%; width: 0; background: var(--ink); transition: width .3s ease; }

  main { padding: var(--s6) var(--s7) var(--s7); max-width: 860px; width: 100%; }
  @media (max-width: 900px) {
    .shell { grid-template-columns: 1fr; }
    .sidebar { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
    main { padding: var(--s5) var(--s4) var(--s6); }
  }

  /* ---- 搜索 ---- */
  .search-wrap { position: relative; margin-bottom: var(--s6); }
  .search {
    width: 100%; padding: 11px 40px 11px 40px;
    border: 1px solid var(--line-2); background: var(--bg); border-radius: var(--r2);
    outline: none; color: var(--ink);
  }
  .search::placeholder { color: var(--muted); }
  .search:focus { border-color: var(--ink); }
  .search-ico { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .search-wrap kbd {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    font-family: var(--font-mono); font-size: 11px; color: var(--muted);
    border: 1px solid var(--line); border-radius: var(--r1); padding: 0 5px; line-height: 18px;
  }
  .results {
    position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + var(--s1));
    background: var(--bg); border: 1px solid var(--line-2); border-radius: var(--r2);
    overflow: hidden; display: none;
  }
  .results.open { display: block; }
  .results .item { display: flex; gap: var(--s3); align-items: baseline; padding: var(--s2) var(--s3); }
  .results .item:hover, .results .item.sel { background: var(--bg-sub); }
  .results .w { font-family: var(--font-mono); font-weight: 500; min-width: 120px; }
  .results .d { color: var(--muted); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .results .empty { padding: var(--s3); color: var(--muted); font-size: 13px; }

  /* ---- 首页 ---- */
  .hero { padding-bottom: var(--s5); border-bottom: 1px solid var(--line); margin-bottom: var(--s5); }
  .hero h1 { font-size: 26px; margin-bottom: var(--s2); }
  .hero p { margin: 0; color: var(--ink-2); max-width: 62ch; font-size: 14px; }
  .hero .stats { display: flex; gap: var(--s6); margin-top: var(--s4); }
  .hero .stats div { font-size: 12px; color: var(--muted); }
  .hero .stats b { display: block; font-size: 20px; color: var(--ink); font-weight: 600; font-family: var(--font-mono); }

  .section-h { display: flex; align-items: baseline; justify-content: space-between;
    margin: var(--s6) 0 var(--s3); padding-bottom: var(--s2); border-bottom: 1px solid var(--line); }
  .section-h h2 { font-size: 13px; letter-spacing: .06em; }
  .section-h span { font-size: 12px; color: var(--muted); }

  .alpha { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: var(--s2); }
  .alpha a {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: var(--s2) var(--s3); border: 1px solid var(--line); border-radius: var(--r2);
    font-family: var(--font-mono); font-size: 13px;
  }
  .alpha a:hover { border-color: var(--ink); }
  .alpha a em { font-style: normal; font-size: 11px; color: var(--muted); }

  .hist { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .hist a, .hist button {
    padding: 3px var(--s3); border: 1px solid var(--line); border-radius: var(--r1);
    font-size: 13px; color: var(--ink-2);
  }
  .hist a:hover, .hist button:hover { border-color: var(--ink); color: var(--ink); }

  /* ---- 词条 ---- */
  .crumb { font-size: 12px; color: var(--muted); margin-bottom: var(--s4); }
  .crumb a:hover { color: var(--ink); }
  .crumb span { color: var(--line-2); margin: 0 var(--s1); }

  .entry h1 { font-size: 38px; line-height: 1.15; letter-spacing: -0.02em; }
  .phon { display: flex; gap: var(--s2); flex-wrap: wrap; margin: var(--s3) 0 0; }
  .phon button {
    display: inline-flex; align-items: center; gap: 5px;
    border: 1px solid var(--line); border-radius: var(--r1);
    padding: 2px var(--s2); font-size: 13px; color: var(--ink-2); font-family: var(--font-mono);
  }
  .phon button:hover { border-color: var(--ink); color: var(--ink); }
  .phon .tag { color: var(--muted); font-size: 12px; margin-right: var(--s1); }

  .entry-grid { display: grid; grid-template-columns: minmax(0, 1fr) 208px; gap: var(--s6); margin-top: var(--s5); }
  @media (max-width: 760px) { .entry-grid { grid-template-columns: 1fr; } }

  .defs { margin: 0; padding: 0; list-style: none; }
  .defs li {
    display: grid; grid-template-columns: 24px 1fr; gap: var(--s2);
    padding: var(--s3) 0; border-bottom: 1px solid var(--line);
    font-size: 16px; line-height: 1.75;
  }
  .defs li i { font-style: normal; font-family: var(--font-mono); font-size: 12px; color: var(--muted); padding-top: 4px; }

  .example { margin-top: var(--s3); padding-left: var(--s3); border-left: 2px solid var(--line-2); }
  .example .en { margin: 0 0 var(--s1); font-size: 15px; display: flex; align-items: center; gap: var(--s2); flex-wrap: wrap; }
  .example .zh { margin: 0; color: var(--muted); font-size: 13px; }
  .mini {
    display: inline-flex; align-items: center; gap: 4px;
    border: 1px solid var(--line); border-radius: var(--r1);
    padding: 1px var(--s2); font-size: 12px; color: var(--ink-2); font-family: var(--font-ui);
  }
  .mini:hover { border-color: var(--ink); color: var(--ink); }
  .muted { color: var(--muted); font-size: 13px; margin: var(--s2) 0 0; }

  .aside-card { border: 1px solid var(--line); border-radius: var(--r2); padding: var(--s4); }
  .aside-card h3 { font-size: 11px; letter-spacing: .08em; color: var(--muted); margin-bottom: var(--s3); }
  .aside-card dl { margin: 0 0 var(--s3); display: grid; grid-template-columns: auto 1fr; gap: var(--s2); font-size: 13px; }
  .aside-card dt { color: var(--muted); }
  .aside-card dd { margin: 0; text-align: right; font-family: var(--font-mono); }
  .btn {
    display: flex; align-items: center; justify-content: center; gap: var(--s2);
    width: 100%; padding: 9px var(--s3); border: 1px solid var(--line-2);
    border-radius: var(--r2); font-size: 14px; color: var(--ink);
  }
  .btn:hover { border-color: var(--ink); }
  .btn + .btn { margin-top: var(--s2); }
  .btn.on { background: var(--bg-strong); border-color: var(--bg-strong); color: var(--bg); }

  .pager { display: flex; align-items: center; justify-content: space-between;
    margin-top: var(--s6); padding-top: var(--s3); border-top: 1px solid var(--line); }
  .pager a { display: inline-flex; align-items: center; gap: var(--s2); font-size: 13px; color: var(--ink-2); }
  .pager a:hover { color: var(--ink); }
  .pager span { color: var(--muted); font-size: 12px; font-family: var(--font-mono); }

  .rel { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s3); }
  .rel a {
    padding: 2px var(--s2); border: 1px solid var(--line); border-radius: var(--r1);
    font-size: 13px; font-family: var(--font-mono);
  }
  .rel a:hover { border-color: var(--ink); }

  /* ---- 列表 ---- */
  .wordlist { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0 var(--s5); margin-top: var(--s2); }
  .wordlist a { display: flex; align-items: baseline; gap: var(--s3); padding: 9px 0; border-bottom: 1px solid var(--line); }
  .wordlist a:hover span { text-decoration: underline; }
  .wordlist a span { font-family: var(--font-mono); font-size: 14px; }
  .wordlist a em { font-style: normal; color: var(--muted); font-size: 12px; flex: 1; min-width: 0;
                   text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hit { background: #ededed; }
  .empty-box { border: 1px dashed var(--line-2); border-radius: var(--r2); padding: var(--s6); text-align: center; color: var(--muted); font-size: 14px; }

  /* ---- 学习 ---- */
  .study-meta { display: flex; gap: var(--s5); color: var(--muted); font-size: 12px; font-family: var(--font-mono); margin-bottom: var(--s4); }
  .card-area { display: grid; place-items: center; padding: var(--s5) 0; }
  .flashcard {
    width: min(520px, 100%); min-height: 260px; border: 1px solid var(--line-2); border-radius: var(--r3);
    background: var(--bg); display: grid; place-items: center; text-align: center; padding: var(--s6);
    cursor: pointer; position: relative;
  }
  .flashcard .front { font-size: 36px; font-family: var(--font-mono); letter-spacing: -0.01em; }
  .flashcard .back { font-size: 17px; line-height: 1.9; }
  .flashcard .hint { position: absolute; bottom: var(--s3); font-size: 12px; color: var(--muted); }
  .study-actions { display: flex; gap: var(--s2); justify-content: center; margin-top: var(--s5); }
  .study-actions .btn { width: auto; padding: 9px var(--s5); }
  .quiz-option {
    display: block; width: 100%; text-align: left; padding: var(--s3) var(--s4); margin-bottom: var(--s2);
    border: 1px solid var(--line-2); border-radius: var(--r2); font-size: 15px;
  }
  .quiz-option:hover { border-color: var(--ink); }
  .quiz-option.right { border-color: #111; background: #f2f2f2; }
  .quiz-option.wrong { border-color: #111; background: #fafafa; text-decoration: line-through; }

  /* ---- 动效：克制，只做 1px 位移与透明度 ---- */
  #app { animation: pagein .18s ease-out; }
  @keyframes pagein { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: none; } }

  .alpha a, .results .item, .wordlist a, .aside-card, .flashcard, .quiz-option,
  .hist a, .btn, .letters a, .nav a, .mini, .phon button, .theme-toggle {
    transition: border-color .15s ease, background-color .15s ease, color .15s ease, transform .15s ease;
  }
  .alpha a:hover, .aside-card:hover, .flashcard:hover { transform: translateY(-1px); }
  .wordlist a:hover { transform: translateX(2px); }

  /* ---- 主题切换 ---- */
  .theme-toggle {
    display: flex; align-items: center; gap: var(--s2);
    width: 100%; padding: var(--s2) var(--s3); margin-top: var(--s3);
    border: 1px solid var(--line); border-radius: var(--r2);
    color: var(--ink-2); font-size: 13px;
  }
  .theme-toggle:hover { border-color: var(--ink); color: var(--ink); }

  /* ---- 生词本工具条 / 设置项 ---- */
  .book-bar { display: flex; flex-wrap: wrap; gap: var(--s2); margin: var(--s4) 0 var(--s5); }
  .book-bar .btn { width: auto; padding: 7px var(--s4); font-size: 13px; }
  .check { display: flex; align-items: center; gap: var(--s2); font-size: 14px; color: var(--ink-2); margin-top: var(--s3); }
  .check input { width: 15px; height: 15px; accent-color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }

  footer.site { margin-top: var(--s7); padding-top: var(--s4); border-top: 1px solid var(--line);
    color: var(--muted); font-size: 12px; line-height: 1.9; }
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z"/></symbol>
    <symbol id="i-book" viewBox="0 0 24 24"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v18H6.5A1.5 1.5 0 0 1 5 19.5z"/><path d="M9.5 3v18"/></symbol>
    <symbol id="i-cards" viewBox="0 0 24 24"><rect x="3.5" y="7" width="11" height="14" rx="1.5"/><path d="M7.5 4h9a2 2 0 0 1 2 2v11"/></symbol>
    <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><path d="M12 7.6v.6"/></symbol>
    <symbol id="i-volume" viewBox="0 0 24 24"><path d="M11 5 6.5 9H4v6h2.5L11 19z"/><path d="M15 9.2a4 4 0 0 1 0 5.6"/><path d="M17.6 6.6a8 8 0 0 1 0 10.8"/></symbol>
    <symbol id="i-left" viewBox="0 0 24 24"><path d="M14.5 6 8.5 12l6 6"/></symbol>
    <symbol id="i-right" viewBox="0 0 24 24"><path d="M9.5 6l6 6-6 6"/></symbol>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></symbol>
  </defs>
</svg>

<div class="shell">
  <aside class="sidebar">
    <div class="brand"><b>CET-4 词林</b><span>v1.0</span></div>

    <nav class="nav" id="nav">
      <a href="#/" data-route="home"><svg class="ico"><use href="#i-home"/></svg><span>首页</span></a>
      <a href="#/book" data-route="book"><svg class="ico"><use href="#i-book"/></svg><span>生词本</span><em id="book-count">0</em></a>
      <a href="#/study" data-route="study"><svg class="ico"><use href="#i-cards"/></svg><span>学习模式</span></a>
      <a href="#/about" data-route="about"><svg class="ico"><use href="#i-info"/></svg><span>关于</span></a>
    </nav>

    <div class="side-title">按字母</div>
    <div class="letters" id="letters"></div>

    <button class="theme-toggle" id="theme-toggle" type="button">
      <svg class="ico"><use id="theme-icon" href="#i-moon"/></svg>
      <span id="theme-label">深色模式</span>
    </button>

    <div class="progress">
      <div class="row"><span>已掌握</span><span id="known-count">0 / 2607</span></div>
      <div class="bar"><i id="known-bar"></i></div>
      <div class="row"><span>生词</span><span id="book-count-2">0</span></div>
    </div>
  </aside>

  <main>
    <div class="search-wrap">
        <svg class="ico search-ico"><use href="#i-search"/></svg>
      <input id="q" class="search" type="search" placeholder="搜索单词或中文释义，例如 abandon / 放弃" autocomplete="off" spellcheck="false" />
      <kbd>/</kbd>
      <div class="results" id="results"></div>
    </div>
    <div id="app"></div>
    <footer class="site">
      词库来源：CET-4 核心词汇 2607 条 · 纯静态单页，可离线打开 · 学习记录只存本机浏览器<br>制作工具：DeepSeek Harness（DSH）· 视觉规范参考 Anthropic Skills 的 frontend-design / theme-factory
    </footer>
  </main>
</div>

<script src="data.js"></script>
<script src="examples.js"></script>
<script>
(() => {
  'use strict';

  const WORDS = (window.CET4_WORDS || []).map(w => ({
    n: w.n,
    t: Array.isArray(w.t) ? w.t : [String(w.t || '')],
    u: w.u || '',
    k: w.k || '',
    lower: w.n.toLowerCase(),
  }));

  const EXAMPLES = window.CET4_EXAMPLES || {};
  const INDEX = new Map(WORDS.map((w, i) => [w.lower, i]));
  const byLetter = new Map();
  for (const w of WORDS) {
    const L = w.n[0].toUpperCase();
    if (!byLetter.has(L)) byLetter.set(L, []);
    byLetter.get(L).push(w);
  }

  const LS = {
    get(k, d) { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch { return d; } },
    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
  };
  let book = new Set(LS.get('cet4.book', []));
  let known = new Set(LS.get('cet4.known', []));
  let recent = LS.get('cet4.recent', []);

  const app = document.getElementById('app');
  const $ = (s) => document.querySelector(s);
  const esc = (s) => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  /* ---------- 朗读 ---------- */
  function speakWord(text, lang = 'en-US') {
    if (!text || typeof speechSynthesis === 'undefined') return;
    const u = new SpeechSynthesisUtterance(String(text));
    u.lang = lang;
    u.rate = 0.95;
    speechSynthesis.cancel();
    speechSynthesis.speak(u);
  }

  /* ---------- 主题 ---------- */
  const THEME_KEY = 'cet4.theme';
  function applyTheme(theme) {
    document.documentElement.dataset.theme = theme;
    LS.set(THEME_KEY, theme);
    const icon = document.getElementById('theme-icon');
    const label = document.getElementById('theme-label');
    if (icon) icon.setAttribute('href', theme === 'dark' ? '#i-sun' : '#i-moon');
    if (label) label.textContent = theme === 'dark' ? '浅色模式' : '深色模式';
  }
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
  applyTheme(LS.get(THEME_KEY, window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));

  /* ---------- 侧栏 ---------- */
  function renderSidebar() {
    const letters = document.getElementById('letters');
    letters.innerHTML = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map(L => {
      const n = byLetter.get(L)?.length || 0;
      return n
        ? `<a href="#/l/${L}">${L}<em>${n}</em></a>`
        : `<a class="dim">${L}</a>`;
    }).join('');

    const pct = WORDS.length ? (known.size / WORDS.length) * 100 : 0;
    $('#known-count').textContent = `${known.size} / ${WORDS.length}`;
    $('#known-bar').style.width = pct.toFixed(1) + '%';
    $('#book-count').textContent = String(book.size);
    $('#book-count-2').textContent = String(book.size);
  }

  function setActiveNav(route) {
    document.querySelectorAll('#nav a').forEach(a => a.classList.toggle('on', a.dataset.route === route));
  }

  /* ---------- 搜索 ---------- */
  const qInput = $('#q');
  const resultsBox = $('#results');
  let sel = -1;
  let current = [];

  function search(q) {
    const s = q.trim().toLowerCase();
    if (!s) return [];
    const exact = [], prefix = [], sub = [], cn = [];
    for (const w of WORDS) {
      if (w.lower === s) exact.push(w);
      else if (w.lower.startsWith(s)) prefix.push(w);
      else if (w.lower.includes(s)) sub.push(w);
      else if (w.t.some(t => t.includes(s))) cn.push(w);
      if (exact.length + prefix.length + sub.length + cn.length > 400) break;
    }
    return [...exact, ...prefix, ...sub, ...cn].slice(0, 12);
  }

  function renderResults(list) {
    current = list;
    sel = -1;
    if (!list.length) {
      resultsBox.innerHTML = '<div class="empty">没有匹配的词，试试换一个拼写或中文关键词</div>';
      resultsBox.classList.add('open');
      return;
    }
    resultsBox.innerHTML = list.map((w, i) => `
      <a class="item" href="#/w/${encodeURIComponent(w.n)}" data-i="${i}">
        <span class="w">${esc(w.n)}</span>
        <span class="d">${esc(w.t.join('；'))}</span>
      </a>`).join('')
      + `<a class="item" style="justify-content:center;color:var(--accent)" href="#/search/${encodeURIComponent(qInput.value.trim())}">查看全部「${esc(qInput.value.trim())}」的结果</a>`;
    resultsBox.classList.add('open');
  }

  qInput.addEventListener('input', () => renderResults(search(qInput.value)));
  qInput.addEventListener('focus', () => { if (qInput.value.trim()) renderResults(search(qInput.value)); });
  qInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { resultsBox.classList.remove('open'); qInput.blur(); return; }
    if (!current.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + current.length) % current.length;
      [...resultsBox.querySelectorAll('.item')].forEach((el, i) => el.classList.toggle('sel', i === sel));
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      const w = current[sel < 0 ? 0 : sel];
      if (w) { pushHistory(qInput.value.trim()); qInput.value = ''; resultsBox.classList.remove('open'); location.hash = '#/w/' + encodeURIComponent(w.n); }
    }
  });
  document.addEventListener('click', (e) => {
    if (!resultsBox.contains(e.target) && e.target !== qInput) resultsBox.classList.remove('open');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== qInput) { e.preventDefault(); qInput.focus(); }
  });

  /* ---------- 页面 ---------- */
  function pushHistory(q) {
    if (!q) return;
    let h = LS.get('cet4.history', []);
    h = [q, ...h.filter(x => x !== q)].slice(0, 8);
    LS.set('cet4.history', h);
  }

  function highlight(text, q) {
    const t = esc(text);
    if (!q) return t;
    const safe = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return t.replace(new RegExp('(' + safe + ')', 'gi'), '<span class="hit">$1</span>');
  }

  function pageSearch(q) {
    const s = String(q || '').trim();
    const hits = search(s);
    const all = [];
    if (s) {
      const low = s.toLowerCase();
      for (const w of WORDS) {
        if (w.lower.includes(low) || w.t.some(t => t.includes(s))) all.push(w);
      }
    }
    return `
      <div class="crumb"><a href="#/">词库</a> / 搜索</div>
      <h1 style="margin:0 0 6px;font-size:28px">「${esc(s)}」</h1>
      <p class="muted" style="margin:0 0 20px">命中 ${all.length} 个词条${hits.length ? '，前 ' + hits.length + ' 个已按相关度排序' : ''}</p>
      ${all.length
        ? `<div class="wordlist">${all.slice(0, 120).map(w => `<a href="#/w/${encodeURIComponent(w.n)}"><span>${highlight(w.n, s)}</span><em>${esc(w.t.join('；'))}</em></a>`).join('')}</div>`
        : '<div class="empty-box">没有命中。试试更短的拼写，或者换个中文关键词。</div>'}
    `;
  }

  function pageHome() {
    const today = WORDS[Math.floor((Date.now() / 86400000)) % WORDS.length];
    const rec = recent.slice(0, 6).map(n => INDEX.get(n.toLowerCase())).filter(i => i !== undefined).map(i => WORDS[i]);
    return `
      <section class="hero">
        <h1>四级词汇百科</h1>
        <p>把 CET-4 的 ${WORDS.length} 个核心词做成可查阅、可标记、可复习的词典。左边按字母翻，顶上直接搜；遇到不熟的词点「加入生词本」，学完点「已掌握」。</p>
        <div class="stats">
          <div><b>${WORDS.length}</b>收录词条</div>
          <div><b>${byLetter.size}</b>首字母分组</div>
          <div><b>${known.size}</b>已掌握</div>
          <div><b>${book.size}</b>生词本</div>
        </div>
      </section>

      ${(LS.get('cet4.history', []).length) ? `
      <div class="section-h"><h2>最近搜索</h2><span>点一下再来一次</span></div>
      <div class="hist">${LS.get('cet4.history', []).map(q => `<a href="#/search/${encodeURIComponent(q)}">${esc(q)}</a>`).join('')}</div>` : ''}

      <div class="section-h"><h2>今日一词</h2><span>每天换一个</span></div>
      <a class="rel" style="text-decoration:none" href="#/w/${encodeURIComponent(today.n)}">
        <span style="font-size:22px;font-family:ui-monospace,monospace">${esc(today.n)}</span>
        <span style="color:var(--muted)">${esc(today.t.join('；'))}</span>
      </a>

      <div class="section-h"><h2>按字母浏览</h2><span>共 ${byLetter.size} 组</span></div>
      <div class="alpha">
        ${[...byLetter.keys()].sort().map(L => `<a href="#/l/${L}">${L}<em>${byLetter.get(L).length}</em></a>`).join('')}
      </div>

      ${rec.length ? `
      <div class="section-h"><h2>最近看过</h2><span>${rec.length} 条</span></div>
      <div class="rel">${rec.map(w => `<a href="#/w/${encodeURIComponent(w.n)}">${esc(w.n)}</a>`).join('')}</div>` : ''}
    `;
  }

  function pageLetter(L) {
    const list = byLetter.get(L) || [];
    return `
      <div class="crumb"><a href="#/">词库</a> / ${L}</div>
      <h1 style="margin:0 0 6px;font-size:30px">${L}</h1>
      <p style="color:var(--muted);margin:0">${list.length} 个词条</p>
      <div class="wordlist">
        ${list.map(w => `<a href="#/w/${encodeURIComponent(w.n)}"><span>${esc(w.n)}</span><em>${esc(w.t[0] || '')}</em></a>`).join('')}
      </div>
    `;
  }

  function similarWords(w) {
    const base = w.lower;
    const head = base.slice(0, 3);
    const cands = [];
    for (const other of WORDS) {
      if (other.lower === base) continue;
      if (other.lower.startsWith(head)) { cands.push([other, 0]); continue; }
      if (Math.abs(other.lower.length - base.length) <= 1 && other.lower[0] === base[0] && editDistance(other.lower, base) <= 2) cands.push([other, 1]);
      if (cands.length > 60) break;
    }
    return cands.sort((a, b) => a[1] - b[1] || a[0].lower.length - b[0].lower.length).slice(0, 8).map(x => x[0]);
  }

  function editDistance(a, b) {
    const m = a.length, n = b.length;
    if (Math.abs(m - n) > 2) return 9;
    let prev = Array.from({ length: n + 1 }, (_, j) => j);
    for (let i = 1; i <= m; i++) {
      const cur = [i];
      for (let j = 1; j <= n; j++) {
        cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
      }
      prev = cur;
    }
    return prev[n];
  }

  function pageWord(name) {
    const idx = INDEX.get(String(name).toLowerCase());
    if (idx === undefined) {
      return `<div class="empty-box">词库里没有「${esc(name)}」。<br><a href="#/">回到首页</a> 再搜一次？</div>`;
    }
    const w = WORDS[idx];
    const inBook = book.has(w.lower);
    const isKnown = known.has(w.lower);
    const rel = similarWords(w);
    const prev = WORDS[idx - 1], next = WORDS[idx + 1];

    recent = [w.n, ...recent.filter(x => x.toLowerCase() !== w.lower)].slice(0, 12);
    LS.set('cet4.recent', recent);

    return `
      <div class="crumb"><a href="#/">词库</a> / <a href="#/l/${w.n[0].toUpperCase()}">${w.n[0].toUpperCase()}</a> / ${esc(w.n)}</div>
      <article class="entry">
        <h1>${esc(w.n)}</h1>
        <div class="phon">
          ${w.u ? `<span>美 <button data-speak="${esc(w.n)}" data-lang="en-US">${esc(w.u)}</button></span>` : ''}
          ${w.k ? `<span>英 <button data-speak="${esc(w.n)}" data-lang="en-GB">${esc(w.k)}</button></span>` : ''}
        </div>

        <div class="entry-grid">
          <section>
            <div class="section-h" style="margin-top:6px"><h2>释义</h2></div>
            <ol class="defs">${w.t.map((t, i) => `<li><i>${String(i + 1).padStart(2, '0')}</i><span>${esc(t)}</span></li>`).join('')}</ol>

            <div class="section-h" style="margin-top:26px"><h2>例句</h2><span>${EXAMPLES[w.n] ? '点击喇叭跟读' : ''}</span></div>
            ${EXAMPLES[w.n]
              ? `<div class="example">
                   <p class="en">${esc(EXAMPLES[w.n].en)} <button class="mini" data-speak="${esc(EXAMPLES[w.n].en)}" data-lang="en-US"><svg class="ico ico-sm"><use href="#i-volume"/></svg>朗读</button></p>
                   <p class="zh">${esc(EXAMPLES[w.n].zh)}</p>
                 </div>`
              : `<p class="muted">这个词暂时没有例句，先用上面的音标跟读；例句正在陆续补充。</p>`}

            ${rel.length ? `
            <div class="section-h"><h2>形近 / 同前缀</h2><span>按相似度排</span></div>
            <div class="rel">${rel.map(r => `<a href="#/w/${encodeURIComponent(r.n)}">${esc(r.n)}</a>`).join('')}</div>` : ''}
          </section>

          <aside>
            <div class="aside-card">
              <h3>词条信息</h3>
              <dl>
                <dt>首字母</dt><dd>${w.n[0].toUpperCase()}</dd>
                <dt>长度</dt><dd>${w.n.length}</dd>
                <dt>释义数</dt><dd>${w.t.length}</dd>
                <dt>序号</dt><dd>${idx + 1}</dd>
              </dl>
              <button class="btn ${inBook ? 'on' : ''}" data-book="${esc(w.n)}">${inBook ? '已在生词本' : '加入生词本'}</button>
              <button class="btn ${isKnown ? 'on' : ''}" data-known="${esc(w.n)}">${isKnown ? '已掌握' : '标记已掌握'}</button>
            </div>
          </aside>
        </div>

        <div class="pager">
          ${prev ? `<a href="#/w/${encodeURIComponent(prev.n)}"><svg class="ico ico-sm"><use href="#i-left"/></svg>${esc(prev.n)}</a>` : '<span>已经是第一个</span>'}
          <span>${idx + 1} / ${WORDS.length}</span>
          ${next ? `<a href="#/w/${encodeURIComponent(next.n)}">${esc(next.n)}<svg class="ico ico-sm"><use href="#i-right"/></svg></a>` : '<span>已经是最后一个</span>'}
        </div>
      </article>
    `;
  }

  function pageBook() {
    const list = [...book].map(n => INDEX.get(n)).filter(i => i !== undefined).map(i => WORDS[i]);
    return `
      <div class="crumb"><a href="#/">词库</a> / 生词本</div>
      <h1 style="margin:0 0 6px;font-size:30px">生词本</h1>
      <p style="color:var(--muted);margin:0">${list.length} 个词，存在本机浏览器里。</p>
      ${list.length ? `<div class="book-bar">
        <button class="btn" data-book-know>全部标记已掌握</button>
        <button class="btn" data-book-clear>清空生词本</button>
      </div>` : ''}
      ${list.length ? `<div class="wordlist">${list.map(w => `<a href="#/w/${encodeURIComponent(w.n)}"><span>${esc(w.n)}</span><em>${esc(w.t[0] || '')}</em></a>`).join('')}</div>`
        : '<div class="empty-box">还空着。去词条页点「加入生词本」，这里就会攒起来。</div>'}
    `;
  }

  /* ---------- 学习模式 ---------- */
  let study = { mode: 'flash', queue: [], i: 0, flipped: false, right: 0, wrong: 0, answered: false };

  function buildQueue() {
    const pool = book.size ? [...book].map(n => INDEX.get(n)).filter(i => i !== undefined).map(i => WORDS[i]) : WORDS;
    study.queue = pool.slice().sort(() => Math.random() - 0.5).slice(0, 20);
    study.i = 0; study.right = 0; study.wrong = 0; study.flipped = false; study.answered = false;
  }

  function pageStudy() {
    if (!study.queue.length) buildQueue();
    const w = study.queue[study.i];
    if (!w) {
      return `<div class="crumb"><a href="#/">词库</a> / 学习模式</div>
        <div class="empty-box"><p>这一轮结束了：答对 ${study.right}，答错 ${study.wrong}。</p>
        <button class="btn" style="width:auto;display:inline-block" data-restart>再来一轮</button></div>`;
    }
    if (study.mode === 'flash') {
      return `
        <div class="crumb"><a href="#/">词库</a> / 学习模式</div>
        <div class="study-meta"><span>${book.size ? '生词本' : '全部词库'}</span><span>${study.i + 1} / ${study.queue.length}</span><span>已掌握 ${known.size}</span></div>
        <div class="card-area">
          <div class="flashcard" data-flip>
            ${study.flipped
              ? `<div class="back">${w.t.map(esc).join('<br>')}</div>`
              : `<div><div class="front">${esc(w.n)}</div>${w.u ? `<div style="color:var(--muted);font-family:ui-monospace,monospace">${esc(w.u)}</div>` : ''}</div>`}
            <div class="hint">点卡片翻面 · 空格键也行</div>
          </div>
        </div>
        <div class="study-actions">
          <button class="btn" data-skip>不认识，下一个</button>
          <button class="btn on" data-know>认识，记下来</button>
        </div>`;
    }
    const options = [w, ...[0, 1, 2].map(() => WORDS[Math.floor(Math.random() * WORDS.length)]).filter(x => x.lower !== w.lower)];
    const shuffled = options.slice().sort(() => Math.random() - 0.5);
    return `
      <div class="crumb"><a href="#/">词库</a> / 学习模式</div>
      <div class="study-meta"><span>看词选义</span><span>${study.i + 1} / ${study.queue.length}</span><span>对 ${study.right} · 错 ${study.wrong}</span></div>
      <div style="margin:26px 0 8px;font-size:36px;font-family:ui-monospace,monospace">${esc(w.n)}</div>
      <div style="color:var(--muted);font-family:ui-monospace,monospace;margin-bottom:18px">${esc(w.u)}</div>
      ${shuffled.map((o, i) => `<button class="quiz-option" data-answer="${esc(o.n)}">${esc(o.t.join('；'))}</button>`).join('')}
      <div style="margin-top:14px;font-size:13px;color:var(--muted)">选错了会直接告诉你正确答案</div>`;
  }

  /* ---------- 关于 ---------- */
  function pageAbout() {
    return `
      <div class="crumb"><a href="#/">词库</a> / 关于</div>
      <h1 style="margin:0 0 14px;font-size:30px">关于这个页面</h1>
      <p>这是一个纯静态的四级词汇百科：没有后端、没有账号、不联网也能用。所有数据都在 <code>data.js</code> 里，学习记录（生词本、已掌握）存在浏览器 localStorage。</p>
      <div class="section-h"><h2>快捷键</h2></div>
      <ul style="line-height:2">
        <li><code>/</code> 聚焦搜索框</li>
        <li><code>↑</code> <code>↓</code> 在搜索结果间移动，<code>Enter</code> 打开</li>
        <li><code>Esc</code> 关闭搜索面板</li>
        <li>词卡页 <code>空格</code> 翻面</li>
      </ul>
      <div class="section-h"><h2>阅读设置</h2></div>
      <label class="check"><input type="checkbox" id="autoread" ${LS.get('cet4.autoread', true) ? 'checked' : ''}> 进入词条时自动朗读单词</label>

      <div class="section-h"><h2>数据</h2></div>
      <p>词条 ${WORDS.length} 条，含美/英音标与中文释义；形近词按编辑距离与共同前缀推导，不引入外部接口。</p>
      <p>其中 ${Object.keys(EXAMPLES).length} 个高频词配有中英对照例句，例句由 AI（DeepSeek Harness）生成并经人工挑选，仅作学习参考，不引用任何受版权保护的词典原文。朗读使用浏览器内置语音合成（Web Speech API），离线可用。</p>
    `;
  }

  /* ---------- 路由 ---------- */
  function route() {
    const hash = location.hash.replace(/^#/, '') || '/';
    const parts = hash.split('/').filter(Boolean);
    if (parts[0] === 'w') { setActiveNav(''); app.innerHTML = pageWord(decodeURIComponent(parts.slice(1).join('/'))); }
    else if (parts[0] === 'l') { setActiveNav(''); app.innerHTML = pageLetter(parts[1]); }
    else if (parts[0] === 'book') { setActiveNav('book'); app.innerHTML = pageBook(); }
    else if (parts[0] === 'study') { setActiveNav('study'); app.innerHTML = pageStudy(); }
    else if (parts[0] === 'search') { setActiveNav(''); app.innerHTML = pageSearch(decodeURIComponent(parts.slice(1).join('/'))); }
    else if (parts[0] === 'about') { setActiveNav('about'); app.innerHTML = pageAbout(); }
    else { setActiveNav('home'); app.innerHTML = pageHome(); }
    renderSidebar();
    app.style.animation = 'none';
    void app.offsetHeight;
    app.style.animation = '';
    window.scrollTo({ top: 0, behavior: 'instant' });

    // 进入词条页自动朗读单词（可在「关于」里关掉）
    if (parts[0] === 'w' && LS.get('cet4.autoread', true)) {
      const word = decodeURIComponent(parts.slice(1).join('/'));
      setTimeout(() => speakWord(word), 160);
    }
  }

  /* ---------- 事件 ---------- */
  document.addEventListener('click', (e) => {
    const t = e.target.closest('[data-book],[data-known],[data-book-know],[data-book-clear],[data-speak],[data-flip],[data-know],[data-skip],[data-answer],[data-restart]');
    if (!t) return;

    if (t.dataset.speak) {
      speakWord(t.dataset.speak, t.dataset.lang || 'en-US');
      return;
    }
    if (t.hasAttribute('data-book-clear')) {
      if (!book.size) return;
      if (window.confirm('清空生词本里的 ' + book.size + ' 个词？')) {
        book.clear();
        LS.set('cet4.book', []);
        route();
      }
      return;
    }
    if (t.hasAttribute('data-book-know')) {
      for (const n of book) known.add(n);
      LS.set('cet4.known', [...known]);
      route();
      return;
    }
    if (t.dataset.book) {
      const key = t.dataset.book.toLowerCase();
      book.has(key) ? book.delete(key) : book.add(key);
      LS.set('cet4.book', [...book]);
      route();
      return;
    }
    if (t.dataset.known) {
      const key = t.dataset.known.toLowerCase();
      known.has(key) ? known.delete(key) : known.add(key);
      LS.set('cet4.known', [...known]);
      route();
      return;
    }
    if (t.hasAttribute('data-flip')) { study.flipped = !study.flipped; route(); return; }
    if (t.hasAttribute('data-know')) {
      known.add(study.queue[study.i].lower);
      LS.set('cet4.known', [...known]);
      study.i++; study.flipped = false; route(); return;
    }
    if (t.hasAttribute('data-skip')) { study.i++; study.flipped = false; route(); return; }
    if (t.hasAttribute('data-restart')) { study.queue = []; route(); return; }
    if (t.dataset.answer) {
      const w = study.queue[study.i];
      const ok = t.dataset.answer === w.n;
      t.classList.add(ok ? 'right' : 'wrong');
      if (!ok) {
        const el = [...document.querySelectorAll('.quiz-option')].find(o => o.dataset.answer === w.n);
        if (el) el.classList.add('right');
      }
      ok ? study.right++ : study.wrong++;
      if (ok) known.add(w.lower);
      LS.set('cet4.known', [...known]);
      setTimeout(() => { study.i++; route(); }, ok ? 420 : 1100);
    }
  });

  document.addEventListener('keydown', (e) => {
    // 词条页 ← / → 切换上一个 / 下一个
    if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') &&
        location.hash.startsWith('#/w/') && document.activeElement.tagName !== 'INPUT') {
      const name = decodeURIComponent(location.hash.slice(4));
      const idx = INDEX.get(name.toLowerCase());
      if (idx !== undefined) {
        const target = WORDS[e.key === 'ArrowLeft' ? idx - 1 : idx + 1];
        if (target) {
          e.preventDefault();
          location.hash = '#/w/' + encodeURIComponent(target.n);
        }
      }
      return;
    }
    if (e.key === ' ' && location.hash.startsWith('#/study') && document.activeElement.tagName !== 'INPUT') {
      e.preventDefault();
      study.flipped = !study.flipped;
      route();
    }
  });

  document.addEventListener('change', (e) => {
    if (e.target && e.target.id === 'autoread') {
      LS.set('cet4.autoread', e.target.checked);
    }
  });

  window.addEventListener('hashchange', route);
  route();
})();
</script>
</body>
</html>
